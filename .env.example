# --- Core ---
# Locally both are the same. On Supabase: DATABASE_URL = transaction pooler (:6543) + "?pgbouncer=true&connection_limit=1",
# DIRECT_URL = session pooler (:5432), used by Prisma for migrations.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/fynwyn?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/fynwyn?schema=public"
APP_URL="http://localhost:3000"
# Long random strings (openssl rand -base64 48). Customer and staff secrets MUST differ.
CUSTOMER_SESSION_SECRET=""
STAFF_SESSION_SECRET=""

# --- Staff console isolation ---
# ADMIN_ENABLED=false on the public/customer deployment removes /admin and /api/admin entirely.
ADMIN_ENABLED="true"
# If set, the staff console is served ONLY on this host (e.g. staff.fynwyn.com); the
# customer host returns 404 for /admin. Leave empty in local dev.
ADMIN_HOST=""
# Optional comma-separated IP allow-list for staff routes.
ADMIN_ALLOWED_IPS=""

# --- Paystack (leave empty to disable card/online payments) ---
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
# Webhook URL to register in the Paystack dashboard: {APP_URL}/api/webhooks/paystack
# PAYSTACK_BASE_URL is only for tests/mocks; leave unset in real environments.

# --- Manual bank transfer details shown to customers ---
BANK_NAME="Your Bank"
BANK_ACCOUNT_NAME="FYNWYN Group Enterprises"
BANK_ACCOUNT_NUMBER="0000000000"

# --- Google Sheet mirror (optional). The app database stays the source of truth; these tabs are kept up to date:
#     CUSTOMERS, TRANSACTIONS, ORDERS, ORDER_ITEMS, REWARD_ENTITLEMENTS, PACKAGES, PACKAGE_REWARDS, PRODUCTS,
#     INVENTORY_MOVEMENTS, AUDIT_LOG. Share the spreadsheet with the service account email as "Editor".
GOOGLE_SHEETS_ID=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""   # keep the \n escapes, wrap in quotes
# Only data created/changed on or after this date is pushed (protects the sheet from demo/legacy rows). Required to switch sync on.
SHEET_SYNC_SINCE=""     # e.g. 2026-10-14
# Secret for the optional scheduled catch-up call: GET /api/cron/sheet-sync with "Authorization: Bearer <secret>"
CRON_SECRET=""


# --- Cloudinary (product image uploads in the staff console). Dashboard > Settings > API Keys.
# The secret is server-only. Images are stored under CLOUDINARY_FOLDER and only that folder is accepted.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="fynwyn/products"

# --- Email. Production uses Brevo's HTTPS API (Render's free tier blocks SMTP ports): set BREVO_API_KEY
# (Brevo > SMTP & API > API Keys) and an EMAIL_FROM whose address is a verified sender (Brevo > Senders).
# If BREVO_API_KEY is empty, SMTP below is used; if SMTP_HOST is also empty, emails print to the console. ---
BREVO_API_KEY=""
# Local testing with Mailpit: `npm run mail:dev`, then SMTP_HOST=localhost SMTP_PORT=1025 (no user/pass); inbox at http://localhost:8025
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="FYNWYN Drink Bank <no-reply@fynwyn.com>"
